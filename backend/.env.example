# ---- Copy this file to ".env" and fill in your own values ----
# NEVER commit your real .env to git. NEVER put keys in frontend/client code.

# Port the server listens on
PORT=3000

# "production" turns on Secure cookies + HSTS and refuses to start without a real JWT_SECRET.
NODE_ENV=development

# Public URL of the site — used in password-reset email links. Required in production.
APP_URL=http://localhost:3000

# Set to 1 when running behind a proxy/load balancer (Render, Railway…) so rate limits see real IPs.
TRUST_PROXY=

# The one account allowed into the admin page (/#admin): products, orders, emails, backups.
ADMIN_EMAIL=

# Logs: LOG_LEVEL = error | warn | info | debug | silent. LOG_FORMAT=json for one JSON object per line
# (automatic in production).
LOG_LEVEL=info
LOG_FORMAT=

# Backups: a copy of the database every BACKUP_INTERVAL_HOURS (0 = off), newest BACKUP_KEEP kept.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=

# Optional crash reports: set this and run `npm install @sentry/node`.
SENTRY_DSN=

# Optional: where the SQLite file lives (defaults to backend/kanti.db).
# DB_FILE=

# Secret used to sign login sessions (JWT). At least 32 characters. If unset in development,
# a random one is generated per run (everyone gets signed out on restart).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- AI (optional) ----
# If set, the quiz results are generated dynamically by Google Gemini.
# If left blank, the server uses a built-in rule-based classifier instead.
# Get a key at https://aistudio.google.com/app/apikey  (keep it secret, server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite

# ---- Email (optional) ----
# Leave ALL of these blank for development: the server will auto-create a free
# Ethereal test inbox and print a preview URL for every email it "sends".
# To send REAL email, fill these in (e.g. a Gmail App Password, Resend, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kanti <orders@kanti.example>

# --- AI recommendations (optional; all use GEMINI_API_KEY) ---
# Shops "Beyond Kanti" links to (search links always; product pages only after they're checked).
# BEYOND_RETAILERS=nykaa,amazon,sephora,ulta
# Extra domains whose product pages may be shown (e.g. brand sites), comma-separated.
# BEYOND_ALLOWED_DOMAINS=
# Model for live Google Search grounding (needs a key/plan with Search quota). Defaults to GEMINI_MODEL.
# GEMINI_SEARCH_MODEL=
# Hourly per-IP limits for the AI endpoints.
# RATE_AI_MAX=60
# RATE_GUIDE_MAX=40
